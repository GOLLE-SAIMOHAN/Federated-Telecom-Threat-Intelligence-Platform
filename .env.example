# Application configuration
NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173

# Persistence
MONGODB_URI=mongodb://localhost:27017/federated_telecom
MONGODB_DATABASE=federated_telecom

# Federated learning
FL_SERVER_ADDRESS=localhost:8080
FL_ROUNDS=5
RANDOM_SEED=42

# Local dataset configuration
DATASET_PATH=./data/raw/5g-intrusion
DATASET_SUBSET_SIZE=

# Backend artifact location
PROCESSED_DATA_DIR=./data/processed

# Batch intrusion detection
DETECTION_MAX_BYTES=5mb
DETECTION_MAX_ROWS=10000
# Set this in production when the Python inference service is deployed separately.
INFERENCE_URL=
PYTHON_EXECUTABLE=./.venv/Scripts/python.exe
